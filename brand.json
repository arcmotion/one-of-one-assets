    "guides": [
      {
        "title": "Add the logo to Google Slides, PowerPoint or Word",
        "ordered": true,
        "items": [
          "Download the PNG above.",
          "In Google Slides, choose Insert, then Image, then Upload from computer. In PowerPoint or Word, choose Insert, then Pictures.",
          "Resize it by dragging a corner. The proportions stay correct as long as you use a corner."
        ]
      },
      {
        "title": "How to use the logo",
        "items": [
          "Keep clear space around it, so nothing else enters that area.",
          "Don't distort, stretch, rotate or modify the logo.",
          "Don't add effects or decorations.",
          "Make sure it contrasts clearly with the background."
        ]
      }
    ]
